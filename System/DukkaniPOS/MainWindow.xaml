<Window x:Class="DukkaniPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دكاني POS - نظام المبيعات والمخزون الميداني السريع (البيضاء - اليمن)" 
        Height="840" Width="1300"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F1F5F9"
        FontFamily="{StaticResource MainFont}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarBtn" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#CBD5E1" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. SIDEBAR NAVIGATION -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid Margin="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="⚡ دكاني POS السريع" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="نظام مبيعات وتجزئة ميداني (YER)" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    <Separator Margin="0,12,0,0" Background="#334155"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnNavPOS" Content="💳 الكاشير والبيع (F1/F2)" Style="{StaticResource ActiveSidebarBtn}" Click="NavPOS_Click"/>
                    <Button x:Name="BtnNavInventory" Content="📦 إدارة المخزون" Style="{StaticResource SidebarBtn}" Click="NavInventory_Click"/>
                    <Button x:Name="BtnNavDebts" Content="👥 دفتر الديون والعملاء" Style="{StaticResource SidebarBtn}" Click="NavDebts_Click"/>
                    <Button x:Name="BtnNavAnalytics" Content="📊 لوحة التحليلات والتقارير" Style="{StaticResource SidebarBtn}" Click="NavAnalytics_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="⌨️ اختصارات الكيبورد السريعة" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="[F1] دفع كاش  |  [F2] بيع آجل" Foreground="#94A3B8" FontSize="10"/>
                            <TextBlock Text="[F3] بحث سريع |  [F5] تحديث" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                            <TextBlock Text="[Del] حذف صنف | [Esc] تفريغ" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#334155" CornerRadius="6" Padding="8">
                        <TextBlock Text="🟢 قاعدة البيانات متصلة وجاهزة" Foreground="#4ADE80" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- VIEW 1: POS CASHIER TERMINAL -->
            <Grid x:Name="ViewPOS" Grid.Row="0" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍 الباركود (أو 5*باركود):" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Margin="0,0,8,0" Foreground="#0F172A"/>
                        <TextBox Grid.Column="1" x:Name="TxtBarcode" FontSize="18" Padding="8,4" VerticalAlignment="Center" KeyDown="TxtBarcode_KeyDown" Background="#F8FAFC" BorderBrush="#CBD5E1" ToolTip="اكتب الباركود مباشرة، أو اكتب 5*الباركود لإضافة 5 قطع"/>
                        <Button Grid.Column="2" Content="إضافة للسلة 🛒" Click="BtnAddToCart_Click" Background="#2563EB" Foreground="White" FontSize="13" FontWeight="Bold" Padding="14,6" Margin="8,0,4,0" Cursor="Hand"/>
                        <Button Grid.Column="3" Content="🔍 بحث بالاسم (F3)" Click="BtnOpenQuickSearch_Click" Background="#0284C7" Foreground="White" FontSize="13" FontWeight="Bold" Padding="14,6" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button Grid.Column="4" Content="🛑 استرجاع/إلغاء فاتورة" Click="BtnOpenVoidSale_Click" Background="#DC2626" Foreground="White" FontSize="13" FontWeight="Bold" Padding="12,6" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Cart & Checkout Area -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cart DataGrid with Clean Stacked Header -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Neatly Stacked Header (No Text Overlapping) -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="🛒 سلة المبيعات الحالية" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="تخصيص الكمية: يمكنك التعديل مباشرة من الجدول أو إدخال 5*الباركود" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="DgCart" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="36" FontSize="13" GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الباركود" Binding="{Binding Product.ProductID}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Product.ProductName}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                    <DataGridTextColumn Header="سعر البيع (YER)" Binding="{Binding Product.SellingPrice, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="الإجمالي (YER)" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="120" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="حذف" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="❌" Click="BtnRemoveCartItem_Click" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Width="26" Height="24" Cursor="Hand" ToolTip="حذف هذا الصنف (Delete)"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right Checkout Panel -->
                    <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="💳 حاسبة وتفاصيل الدفع السريع" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                            
                            <Border Background="#0F172A" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="المبلغ الإجمالي المطلـوب" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGrandTotal" Text="0 YER" Foreground="#4ADE80" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="العميل (للبيع الآجل):" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CboCustomers" DisplayMemberPath="CustomerName" SelectedValuePath="CustomerID" FontSize="13" Padding="6,4" Margin="0,0,0,20"/>

                            <Button Content="💵 دفع كاش (F1)" Click="BtnPayCash_Click" Background="#16A34A" Foreground="White" FontSize="15" FontWeight="Bold" Height="46" Margin="0,0,0,10" Cursor="Hand"/>
                            <Button Content="📝 تسجيل آجل (F2)" Click="BtnPayCredit_Click" Background="#2563EB" Foreground="White" FontSize="15" FontWeight="Bold" Height="46" Margin="0,0,0,14" Cursor="Hand"/>
                            <Button Content="🗑️ إفراغ السلة (Esc)" Click="BtnClearCart_Click" Background="#94A3B8" Foreground="White" FontSize="12" Height="34" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- VIEW 2: INVENTORY MANAGEMENT -->
            <Grid x:Name="ViewInventory" Grid.Row="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="📦 إدارة المخزون والأصناف" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="📊 تصدير إلى CSV/Excel" Click="BtnExportInventoryCsv_Click" Background="#0D9488" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="🔄 تحديث الجدول (F5)" Click="BtnRefreshInventory_Click" Background="#475569" Foreground="White" Padding="12,6" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                    <DataGrid x:Name="DgProducts" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="34" FontSize="13" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding ProductID}" Width="120"/>
                            <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="سعر التكلفة (YER)" Binding="{Binding CostPrice, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="سعر البيع (YER)" Binding="{Binding SellingPrice, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="الكمية المتاحة" Binding="{Binding StockQuantity}" Width="100"/>
                            <DataGridTextColumn Header="حد التنبيه" Binding="{Binding MinStockWarning}" Width="90"/>
                            <DataGridTemplateColumn Header="حالة المخزون" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StockStatusText}" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="➕ إضافة صنف جديد" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,8"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الباركود:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtNewBarcode" Margin="2"/>
                                <TextBlock Grid.Column="2" Text="اسم المنتج:" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBox Grid.Column="3" x:Name="TxtNewProdName" Margin="2"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="التكلفة:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtNewCost" Margin="2"/>
                                <TextBlock Grid.Column="2" Text="سعر البيع:" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBox Grid.Column="3" x:Name="TxtNewSelling" Margin="2"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الكمية:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtNewQty" Margin="2"/>
                                <TextBlock Grid.Column="2" Text="حد التنبيه:" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBox Grid.Column="3" x:Name="TxtNewMinWarn" Margin="2" Text="5"/>
                            </Grid>
                            <Button Content="حفظ الصنف الجديد" Click="BtnSaveNewProduct_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,6,0,0" Padding="6" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="📥 توريد وتغذية المخزون (Stock Intake)" FontSize="14" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="الباركود / رمز الصنف:" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtIntakeBarcode" Padding="4"/>
                            </StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="الكمية المضافة:" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtIntakeQty" Padding="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="تكلفة التوريد (اختر اختياري):" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtIntakeCost" Padding="4"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="تأكيد التوريد وزيادة المخزون" Click="BtnConfirmIntake_Click" Background="#16A34A" Foreground="White" FontWeight="Bold" Margin="0,10,0,0" Padding="6" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- VIEW 3: DEBT & CUSTOMER MANAGEMENT -->
            <Grid x:Name="ViewDebts" Grid.Row="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="👥 دفتر ديون العملاء والحسابات الآجلة" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="📄 إصدار كشف حساب PDF" Click="BtnExportCustomerPdf_Click" Background="#7C3AED" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="📊 تصدير الديون CSV" Click="BtnExportDebtsCsv_Click" Background="#0D9488" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="🔄 تحديث القائمة (F5)" Click="BtnRefreshCustomers_Click" Background="#475569" Foreground="White" Padding="12,6" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="دليل العملاء والديون القائمة" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1" x:Name="DgCustomers" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgCustomers_SelectionChanged" Background="White" RowHeight="34" FontSize="13" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding CustomerID}" Width="45"/>
                                    <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="*"/>
                                    <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="110"/>
                                    <DataGridTextColumn Header="إجمالي الدين (YER)" Binding="{Binding TotalDebt, StringFormat={}{0:N0}}" Width="120"/>
                                    <DataGridTextColumn Header="السقف الائتماني (YER)" Binding="{Binding CreditLimit, StringFormat={}{0:N0}}" Width="130"/>
                                    <DataGridTextColumn Header="الائتمان المتبقي" Binding="{Binding RemainingCredit, StringFormat={}{0:N0}}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="➕ تسجيل عميل جديد" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,6"/>
                                <TextBlock Text="اسم العميل:" Margin="0,2"/>
                                <TextBox x:Name="TxtCustName" Padding="4"/>
                                <TextBlock Text="رقم الهاتف:" Margin="0,4,0,2"/>
                                <TextBox x:Name="TxtCustPhone" Padding="4"/>
                                <TextBlock Text="السقف الائتماني (YER):" Margin="0,4,0,2"/>
                                <TextBox x:Name="TxtCustLimit" Text="50000" Padding="4"/>
                                <Button Content="إضافة العميل" Click="BtnAddCustomer_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,8,0,0" Padding="6" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="💵 تسجيل سداد / زيادة دين" FontSize="14" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtSelectedCustInfo" Text="العميل المحدد: لم يتم الاختيار" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBlock Text="المبلغ (YER):" Margin="0,2"/>
                                <TextBox x:Name="TxtTxAmount" Padding="4"/>
                                <TextBlock Text="ملاحظات / البيان:" Margin="0,4,0,2"/>
                                <TextBox x:Name="TxtTxNotes" Text="تسديد نقدي" Padding="4"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="💵 تسجيل سداد" Click="BtnRecordPayment_Click" Background="#16A34A" Foreground="White" FontWeight="Bold" Margin="0,0,3,0" Padding="6" Cursor="Hand"/>
                                    <Button Grid.Column="1" Content="➕ زيادة دين" Click="BtnRecordDebt_Click" Background="#DC2626" Foreground="White" FontWeight="Bold" Margin="3,0,0,0" Padding="6" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- VIEW 4: ANALYTICS DASHBOARD -->
            <Grid x:Name="ViewAnalytics" Grid.Row="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📊 التحليلات والتقارير المالية" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <DatePicker Grid.Column="1" x:Name="DpAnalyticsDate" VerticalAlignment="Center" Width="140"/>
                        <Button Grid.Column="2" Content="🔍 عرض التقرير" Click="BtnLoadAnalytics_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="12,5" Margin="8,0,0,0" Cursor="Hand"/>
                        <Button Grid.Column="4" Content="🔒 تصفية وإغلاق اليومية" Click="BtnCloseShift_Click" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="12,5" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Grid.Column="5" Content="📊 تصدير التقرير CSV" Click="BtnExportReportCsv_Click" Background="#0D9488" Foreground="White" FontWeight="Bold" Padding="12,5" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Stat Cards -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#065F46" CornerRadius="10" Padding="16" Margin="0,0,6,8">
                        <StackPanel>
                            <TextBlock Text="🟢 إجمالي المبيعات (الإيراد)" Foreground="#A7F3D0" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtStatRevenue" Text="0 YER" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#92400E" CornerRadius="10" Padding="16" Margin="3,0,3,8">
                        <StackPanel>
                            <TextBlock Text="🟡 رأس مال التكلفة" Foreground="#FDE68A" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtStatCost" Text="0 YER" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#1E40AF" CornerRadius="10" Padding="16" Margin="6,0,0,8">
                        <StackPanel>
                            <TextBlock Text="🔵 صافي الربح الصافي" Foreground="#BFDBFE" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtStatProfit" Text="0 YER" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Low Stock Alert Grid -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="⚠️ التنبيهات: منتجات قريبة من النفاد بالمخزن" FontSize="15" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" x:Name="DgLowStock" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="32" FontSize="13" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الباركود" Binding="{Binding ProductID}" Width="120"/>
                                <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="الكمية المتاحة حالياً" Binding="{Binding StockQuantity}" Width="150"/>
                                <DataGridTextColumn Header="حد الأمان الأدنى" Binding="{Binding MinStockWarning}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. TOAST NOTIFICATION CONTAINER (BOTTOM SNACKBAR) -->
            <Border x:Name="ToastContainer" Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="16,10" Margin="0,8,0,0" Visibility="Collapsed" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtToastIcon" Grid.Column="0" Text="🟢" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtToastMessage" Grid.Column="1" Text="رسالة تنبيه سريعة" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="✕" Click="BtnDismissToast_Click" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 4. QUICK SEARCH MODAL OVERLAY (POPUP DIALOG - F3) WITH DROP SHADOW -->
            <Grid x:Name="ModalQuickSearch" Grid.RowSpan="2" Background="#900F172A" Visibility="Collapsed">
                <Border Width="650" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#0F172A" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="🔍 البحث السريع عن الأصناف (F3)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Content="✕ إغلاق (Esc)" Click="BtnCloseQuickSearch_Click" HorizontalAlignment="Left" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="8,4" Cursor="Hand"/>
                        </Grid>

                        <TextBox Grid.Row="1" x:Name="TxtSearchQuery" FontSize="16" Padding="8,6" Margin="0,0,0,10" TextChanged="TxtSearchQuery_TextChanged" ToolTip="اكتب اسم المنتج أو جزء من الباركود للفلترة السريعة"/>

                        <DataGrid Grid.Row="2" x:Name="DgSearchResults" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="36" FontSize="13" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الباركود" Binding="{Binding ProductID}" Width="110"/>
                                <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="سعر البيع (YER)" Binding="{Binding SellingPrice, StringFormat={}{0:N0}}" Width="110"/>
                                <DataGridTextColumn Header="المتاح بالمخزن" Binding="{Binding StockQuantity}" Width="100"/>
                                <DataGridTemplateColumn Header="إضافة" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="➕ سلة" Click="BtnAddSearchResultToCart_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="6,2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="3" Text="انقر على '➕ سلة' لإضافة الصنف المختار للسلة المباشرة." Foreground="#64748B" FontSize="12" Margin="0,6,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. VOID SALE MODAL OVERLAY (POPUP DIALOG FOR REFUNDING SALE) -->
            <Grid x:Name="ModalVoidSale" Grid.RowSpan="2" Background="#900F172A" Visibility="Collapsed">
                <Border Width="450" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#0F172A" Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="🛑 إلغاء معاملة وإرجاع البضاعة للمخزن" FontSize="16" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                            <Button Content="✕ إغلاق" Click="BtnCloseVoidSale_Click" HorizontalAlignment="Left" Background="#64748B" Foreground="White" FontWeight="Bold" Padding="8,4" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="أدخل رقم الفاتورة / المعاملة (SaleID):" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtVoidSaleId" FontSize="18" Padding="8,6" Margin="0,0,0,16"/>

                        <Button Content="🛑 تأكيد إلغاء الفاتورة وإسترجاع المخزون" Click="BtnConfirmVoidSale_Click" Background="#DC2626" Foreground="White" FontSize="14" FontWeight="Bold" Height="44" Cursor="Hand"/>
                        <TextBlock Text="سيؤدي إلغاء الفاتورة لإعادة الكميات المباعة تلقائياً للمخزن وتعديل الدين إن كان آكلاً." Foreground="#64748B" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
